- name: Low Pass Filter
  id: low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'Channel filter. Cutoff near +/-100 kHz is a starting point for one FM broadcast channel; change for Exercise 1.'
    cutoff: '100e3'
    decim: 'int(samp_rate/channel_rate)'
    gain: '1'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_ccf
    width: '50e3'
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 160]
    rotation: 0
    state: enabled

- name: WBFM Receive
  id: analog_wfm_rcv
  parameters:
    affinity: ''
    alias: ''
    audio_decimation: 'int(channel_rate/audio_rate)'
    comment: 'Wideband FM demodulator. Quadrature rate must match channel_rate.'
    maxoutbuf: '0'
    minoutbuf: '0'
    quad_rate: channel_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 180]
    rotation: 0
    state: enabled

- name: Audio Sink
  id: audio_sink
  parameters:
    affinity: ''
    alias: ''
    comment: 'Host sound device. Set samp_rate to audio_rate.'
    device_name: ''
    num_inputs: '1'
    ok_to_block: 'True'
    samp_rate: audio_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 200]
    rotation: 0
    state: enabled

connections:
- [rtlsdr_source, '0', low_pass_filter, '0']
- [low_pass_filter, '0', analog_wfm_rcv, '0']
- [analog_wfm_rcv, '0', audio_sink, '0']

metadata:
  file_format: 1
  grc_version: 3.10.0
