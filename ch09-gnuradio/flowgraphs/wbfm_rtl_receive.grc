options:
  parameters:
    author: Leonardo Galli / Signal companion
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'Minimal WBFM receive path for Chapter 9. Receive-only. Open in GNU Radio Companion, set center frequency to a local FM broadcast, then Run. Block ids must match what gnuradio/grc_parse.py expects for CI.'
    copyright: ''
    description: 'RTL-SDR -> LPF -> WBFM Receive -> Audio Sink'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: wbfm_rtl_receive
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: WBFM RTL Receive
    window_size: (1000,600)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: Options
  id: options
  parameters:
    author: Leonardo Galli / Signal companion
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'RTL-SDR -> LPF -> WBFM Receive -> Audio Sink'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: wbfm_rtl_receive
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: WBFM RTL Receive
    window_size: (1000,600)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

- name: samp_rate
  id: variable
  parameters:
    comment: 'RF sample rate into the stick (Hz). 2.4e6 is a common RTL-SDR starting point.'
    value: '2.4e6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled

- name: center_freq
  id: variable
  parameters:
    comment: 'Center frequency (Hz). Set to a strong local FM broadcast for your area.'
    value: '100.1e6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 12]
    rotation: 0
    state: enabled

- name: channel_rate
  id: variable
  parameters:
    comment: 'Quadrature rate after channel filter / into WBFM Receive. 2.4e6 / 10 = 240e3.'
    value: '240e3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12]
    rotation: 0
    state: enabled

- name: audio_rate
  id: variable
  parameters:
    comment: 'Audio sink rate (Hz). Must match WBFM audio output after decimation.'
    value: '48e3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 12]
    rotation: 0
    state: enabled

